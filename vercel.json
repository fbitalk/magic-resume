{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/server/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "introduce\\.hqstar\\.cn" }],
      "dest": "/moved.html"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ]
}
